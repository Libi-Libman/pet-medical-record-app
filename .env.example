# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in the Supabase dashboard: Project Settings -> API.
# These are EXPO_PUBLIC_ vars, meaning they end up in the client bundle —
# that's expected, the anon/publishable key is meant to be public. Access
# control is enforced by the RLS policies in supabase/rls-policies.sql, not
# by keeping this key secret.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
